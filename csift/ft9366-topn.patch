+
+static gint
+cand_cmp (gconstpointer a, gconstpointer b)
+{
+  const Ft9366Cand *ca = a, *cb = b;
+
+  if (ca->contrast != cb->contrast)
+    return ca->contrast > cb->contrast ? -1 : 1;
+  return ca->index < cb->index ? -1 : ca->index > cb->index;
+}
+
+static gint
+cand_index_cmp (gconstpointer a, gconstpointer b)
+{
+  const Ft9366Cand *ca = a, *cb = b;
+
+  return ca->index < cb->index ? -1 : ca->index > cb->index;
+}
