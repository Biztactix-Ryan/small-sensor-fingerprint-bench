+/* distance from (x, y) to the nearest edge of a w x h image */
+static gfloat
+edge_distance (gfloat x, gfloat y, gint w, gint h)
+{
+  return MIN (MIN (x, y), MIN (w - 1 - x, h - 1 - y));
+}
+
+static void
+test_keypoint_masked (void)
+{
+  g_autoptr(FpiAkazeScaleSpace) ss = NULL;
+  g_autoptr(FpiAkazeFeatures) plain = NULL;
+  g_autoptr(FpiAkazeFeatures) masked = NULL;
+  g_autoptr(FpiAkazeFeatures) again = NULL;
+  const gint w = SIZE * FPI_AKAZE_UPSCALE, h = SIZE * FPI_AKAZE_UPSCALE;
+  g_autofree guint8 *frame = g_new (guint8, SIZE * SIZE);
+  g_autofree guint8 *prepared = g_new (guint8, w * h);
+  gfloat plain_edge = G_MAXFLOAT, masked_edge = G_MAXFLOAT;
+  guint partial = 0, full = 0, same = 0;
+
+  synthetic_frame (ENROLLED_FRAME, frame);
+  fpi_keypoint_prepare_image_full (frame, SIZE, SIZE, FPI_AKAZE_UPSCALE,
+                                   FPI_AKAZE_CLAHE_CLIP, prepared);
+  ss = fpi_akaze_scale_space_new (prepared, w, h);
+
+  plain = fpi_akaze_extract (prepared, w, h, FPI_AKAZE_THRESHOLD, G_MAXUINT);
+  masked = fpi_akaze_extract_masked (prepared, w, h, FPI_AKAZE_MASKED_BORDER,
+                                     FPI_AKAZE_THRESHOLD, G_MAXUINT);
+  again = fpi_akaze_extract_masked (prepared, w, h, FPI_AKAZE_MASKED_BORDER,
+                                    FPI_AKAZE_THRESHOLD, G_MAXUINT);
+  g_assert_null (plain->masks);
+  g_assert_null (plain->valid_bits);
+  g_assert_nonnull (masked->masks);
+  g_assert_nonnull (masked->valid_bits);
+
+  /* repeatable */
+  g_assert_cmpuint (masked->n, ==, again->n);
+  g_assert_cmpmem (masked->keypoints, sizeof (FpiAkazeKeypoint) * masked->n,
+                   again->keypoints, sizeof (FpiAkazeKeypoint) * again->n);
+  g_assert_cmpmem (masked->descriptors, FPI_AKAZE_DESCRIPTOR_LEN * masked->n,
+                   again->descriptors, FPI_AKAZE_DESCRIPTOR_LEN * again->n);
+  g_assert_cmpmem (masked->masks, FPI_AKAZE_DESCRIPTOR_LEN * masked->n,
+                   again->masks, FPI_AKAZE_DESCRIPTOR_LEN * again->n);
+
+  for (guint i = 0; i < plain->n; i++)
+    plain_edge = MIN (plain_edge, edge_distance (plain->keypoints[i].x,
+                                                 plain->keypoints[i].y, w, h));
+
+  for (guint i = 0; i < masked->n; i++)
+    {
+      const FpiAkazeKeypoint *kp = &masked->keypoints[i];
+      const FpiAkazeLevel *l = &ss->levels[kp->level];
+      const guint8 *d = masked->descriptors + i * FPI_AKAZE_DESCRIPTOR_LEN;
+      const guint8 *m = masked->masks + i * FPI_AKAZE_DESCRIPTOR_LEN;
+      guint bits = 0;
+
+      for (guint j = 0; j < FPI_AKAZE_DESCRIPTOR_LEN; j++)
+        {
+          bits += __builtin_popcount (m[j]);
+          /* invalid bits are cleared */
+          g_assert_cmphex (d[j] & ~m[j], ==, 0);
+        }
+      g_assert_cmphex (m[FPI_AKAZE_DESCRIPTOR_LEN - 1] & 0xc0, ==, 0);
+      g_assert_cmpuint (bits, ==, masked->valid_bits[i]);
+      g_assert_cmpuint (bits, <=, FPI_AKAZE_DESCRIPTOR_BITS);
+
+      /* a descriptor window that fits the level is all valid */
+      if (edge_distance (kp->x / l->octave_ratio, kp->y / l->octave_ratio,
+                         l->width, l->height) >= l->border)
+        g_assert_cmpuint (bits, ==, FPI_AKAZE_DESCRIPTOR_BITS);
+
+      if (bits == FPI_AKAZE_DESCRIPTOR_BITS)
+        full++;
+      else
+        partial++;
+      masked_edge = MIN (masked_edge, edge_distance (kp->x, kp->y, w, h));
+
+      /* and where opencv has the keypoint, so is the descriptor */
+      for (guint j = 0; j < plain->n; j++)
+        if (memcmp (&plain->keypoints[j], kp, sizeof (*kp)) == 0)
+          {
+            g_assert_cmpmem (plain->descriptors + j * FPI_AKAZE_DESCRIPTOR_LEN,
+                             FPI_AKAZE_DESCRIPTOR_LEN, d, FPI_AKAZE_DESCRIPTOR_LEN);
+            same++;
+          }
+    }
+
+  g_assert_cmpuint (full, >, 0);
+  g_assert_cmpuint (partial, >, 0);
+  /* a few go to stronger maxima nearer the edge */
+  g_assert_cmpuint (same, >, plain->n * 8 / 10);
+  g_assert_cmpfloat (masked_edge, <, plain_edge);
+  /* within derivative support plus refinement of the edge at 3x */
+  g_assert_cmpfloat (masked_edge, <, FPI_AKAZE_UPSCALE * 3);
