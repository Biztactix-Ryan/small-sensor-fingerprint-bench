+#define N_GRID 8
+#define DLEN FPI_AKAZE_DESCRIPTOR_LEN
+
+/* random descriptor bits, the last 2 of byte 60 zero */
+static void
+random_descriptor (guint32 seed, guint8 *d)
+{
+  for (guint j = 0; j < DLEN; j++)
+    d[j] = mix (seed * 977 + j) & 0xff;
+  d[DLEN - 1] &= 0x3f;
+}
+
+/* the first @bits descriptor bits valid */
+static void
+first_bits (guint bits, guint8 *m)
+{
+  memset (m, 0, DLEN);
+  for (guint j = 0; j < bits; j++)
+    m[j / 8] |= 1 << (j % 8);
+}
+
+/* flips @n valid bits of @d from bit @from on */
+static void
+flip_bits (guint8 *d, guint from, guint n)
+{
+  for (guint j = from; j < from + n; j++)
+    d[j / 8] ^= 1 << (j % 8);
+}
+
+/* N_GRID probe keypoints on a grid; the gallery has each at the same place
+ * (b) with @b_flipped of its bits flipped, all @b_bits valid, and with
+ * @a_bits > 0 also at a random place (a), 32 of its first a_bits = 256
+ * flipped, the rest invalid. The score is N_GRID when b is the match. */
+static guint
+grid_score (guint b_bits, guint b_flipped, guint a_bits, guint min_valid)
+{
+  FpiKeypoint pp[N_GRID], gp[2 * N_GRID];
+  guint8 pd[N_GRID * DLEN], pm[N_GRID * DLEN];
+  guint8 gd[2 * N_GRID * DLEN], gm[2 * N_GRID * DLEN];
+  guint ng = 0;
+  FpiKeypoints p, g;
+
+  for (guint k = 0; k < N_GRID; k++)
+    {
+      guint8 *b = gd + ng * DLEN;
+
+      pp[k] = (FpiKeypoint){ 20 + 30 * (k % 4), 20 + 40 * (k / 4) + 3 * k };
+      random_descriptor (k + 1, pd + k * DLEN);
+      first_bits (FPI_AKAZE_DESCRIPTOR_BITS, pm + k * DLEN);
+
+      gp[ng] = pp[k];
+      memcpy (b, pd + k * DLEN, DLEN);
+      flip_bits (b, 0, b_flipped);
+      first_bits (b_bits, gm + ng * DLEN);
+      for (guint j = 0; j < DLEN; j++)
+        b[j] &= gm[ng * DLEN + j];
+      ng++;
+
+      if (a_bits)
+        {
+          guint8 *a = gd + ng * DLEN;
+
+          gp[ng] = (FpiKeypoint){ mix (k + 100) % 250, mix (k + 200) % 250 };
+          memcpy (a, pd + k * DLEN, DLEN);
+          flip_bits (a, 0, 32);
+          first_bits (a_bits, gm + ng * DLEN);
+          for (guint j = 0; j < DLEN; j++)
+            a[j] &= gm[ng * DLEN + j];
+          ng++;
+        }
+    }
+
+  p = (FpiKeypoints){ N_GRID, pp, pd };
+  g = (FpiKeypoints){ ng, gp, gd };
+  return fpi_akaze_match_score_masked (&p, pm, &g, gm, min_valid, NULL);
+}
+
+static void
+test_keypoint_masked_distance (void)
+{
+  /* the same descriptor is distance 0 */
+  g_assert_cmpuint (grid_score (FPI_AKAZE_DESCRIPTOR_BITS, 0, 256, 0), ==, N_GRID);
+  g_assert_cmpuint (grid_score (200, 0, 0, 0), ==, N_GRID);
+
+  /* a: 32 of 256 differ, 60.75 of 486 scaled; b: x of 486. b is nearer
+   * though more of its bits differ, and passes the ratio test while
+   * 4 x 256 < 3 32 486, x <= 45 */
+  g_assert_cmpuint (grid_score (FPI_AKAZE_DESCRIPTOR_BITS, 40, 256, 0), ==, N_GRID);
+  g_assert_cmpuint (grid_score (FPI_AKAZE_DESCRIPTOR_BITS, 45, 256, 0), ==, N_GRID);
+  g_assert_cmpuint (grid_score (FPI_AKAZE_DESCRIPTOR_BITS, 46, 256, 0), ==, 0);
+  /* and scaled the same with half of b valid: 23 of 243 */
+  g_assert_cmpuint (grid_score (243, 22, 256, 0), ==, N_GRID);
+  g_assert_cmpuint (grid_score (243, 23, 256, 0), ==, 0);
+
+  /* a is no candidate below the floor, then b passes against the rest */
+  g_assert_cmpuint (grid_score (FPI_AKAZE_DESCRIPTOR_BITS, 46, 256, 257), ==, N_GRID);
+  /* nothing is a candidate */
+  g_assert_cmpuint (grid_score (160, 0, 0, 160), ==, N_GRID);
+  g_assert_cmpuint (grid_score (160, 0, 0, 161), ==, 0);
+}
